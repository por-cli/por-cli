#!/usr/bin/env bash
HIS="${XDG_STATE_HOME:-$HOME/.local/state}/por-cli/watch.history"

RESUME=0
USE_PROXY=0
SHOW_HELP=0
TERMINAL=0
DOWNLOAD=0

get_open(){
if [ -n "$TERMUX_VERSION" ]; then
   termux-open $1

elif [ $(uname -s) = "Darwin" ]; then
   open $1
 else
  xdg-open $1
fi
}
  
while getopts "rphtd" opt; do
  case "$opt" in
    r) RESUME=1 ;;
    p) USE_PROXY=1 ;;
    h) SHOW_HELP=1 ;;
    t) TERMINAL=1 ;;
    d) DOWNLOAD=1 ;;
    *) exit 1 ;;
  esac
done

shift $((OPTIND-1))

PROXY=""
set_proxy(){
  local delay=0.05
  local spin='|/-\\'
  local i=0

  while :; do
    printf "\rLoading proxy... %c" "${spin:i++%4:1}"

    PROXY=$(curl -s https://raw.githubusercontent.com/por-cli/por-cli/refs/heads/output/https_alive.txt | get_shuf -n 1)

    if curl -s --fail --connect-timeout 1 --max-time 2 \
      -x "$PROXY" https://api.ipify.org >/dev/null; then
    printf "\rLoading proxy... done ✓        "
    printf "\r                               "
    printf "\r"
    return
    fi

    sleep "$delay"
  done
}

spinner() {
  local pid=$1
  local msg="$2"
  local delay=0.1
  local spin='|/-\'
  while kill -0 $pid 2>/dev/null; do
    for i in $(seq 0 3); do
      printf "\r[%c] Loading $msg..." "${spin:$i:1}"
      sleep $delay
    done
  done
  printf "\r                            "
  printf "\r"
}

preview(){
  local img="$1"
  curl -s -x "$PROXY" "$img" | chafa --size=${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES} -
}

player () {
  vid="$1"
  name="$2"
  if [ "$DOWNLOAD" = "1" ]; then
    yt-dlp $vid -o "$name.mp4" --proxy "$PROXY"
  else
    if [ -n "$TERMUX_VERSION" ]; then
      am start -n is.xyz.mpv/is.xyz.mpv.MPVActivity -e args "--http-proxy=$PROXY" -e filepath $vid
      return
    else
      {
        if [ "$TERMINAL" = "0" ]; then
          mpv -fs --http-proxy="$PROXY" --msg-level=all=no $vid
        else
          mpv --vo=kitty --http-proxy="$PROXY" --msg-level=all=no $vid
        fi
      }&
    pid=$!;
    spinner "$pid" "video";
    wait "$pid";
    return
    fi
  fi
}


get_shuf(){
  OS=$(uname -s)

  if [ "$OS" = "Linux" ]; then
    shuf "$@"
  elif [ "$OS" = "Darwin" ]; then
    gshuf "$@"
  fi
}

get_grep(){
  OS=$(uname -s)

  if [ "$OS" = "Linux" ]; then
    grep -oP "$@"
  elif [ "$OS" = "Darwin" ]; then
    ggrep -oP "$@"
  fi
}

export -f spinner
export -f get_shuf
export -f get_grep
export -f preview
export -f player
export TERMINAL
export DOWNLOAD

if [ "$SHOW_HELP" = "1" ] && { [ "$TERMINAL" = "1" ] || [ "$RESUME" = "1" ] || [ "$USE_PROXY" = "1" ]; }; then
  echo "Error: -h cannot be used with -r, -t or -p"
  exit 1
fi

if [ "$SHOW_HELP" = "1" ]; then
  cat <<EOF
por-cli — quick search & watch helper

Usage:
  por-cli [options]

Options:
  -r            Resume & pick from history
  -p            Use proxy
  -t            Play video in terminal (only supported on terminal with kitty graphics protocol)
  -d            Download selected video
  -h, --help    Show this help menu

History file:
  $HIS

Examples:
  por-cli           # interactive search (choose provider)
  por-cli -t        # play video in terminal
  por-cli -d        # download the selected video
  por-cli -dp       # download the selected video with a proxy
  por-cli -r        # search from watch history
  por-cli -rp       # search from watch history with a proxy
  por-cli -p        # watch with a proxy to unblock website 
  por-cli -h        # show help

EOF
exit 0
fi

# Apply proxy if requested
if [ "$USE_PROXY" = "1" ]; then
  set_proxy
fi

# Resume mode
if [ "$RESUME" = "1" ]; then

  if [ ! -s $HIS ]; then
    echo "watch a video first"
    exit 0
  fi
  cat $HIS |
    awk '!seen[$1]++' |
    fzf --prompt="filter:" --layout=reverse --with-shell="bash -c" \
    --bind 'enter:execute(
      url={1};
      echo "$url" >> "${XDG_STATE_HOME:-$HOME/.local/state}/por-cli/watch.history";
      playlist=$(curl -sSf -x "$PROXY" --retry 20 --retry-delay 2 --retry-all-errors "$url" |
        get_grep "https://[^\\\"]+\\.m3u8" |
        head -n1 )
      bash -c "player $playlist"
      )'
      exit 0

fi


provider=`echo "xhamster xvideos eporner donate" | tr ' ' '\n'`
selected=`printf "$provider" | fzf --layout=reverse\
  --prompt="filter:" --header='searches xhamster1.desi' \
  --bind 'focus:transform-header:
case {} in
  donate) echo redircets to donation\ ;;
  eporner) echo searches\ eporner.com ;;
  xvideos) echo searches\ xvideos.com ;;
  xhamster) echo searches\ xhamster.desi ;;
esac'`

if [[ -z $selected ]]; then
  echo "No provider selected" >&2
  exit 2
fi

if [[ $selected == "xhamster" ]]; then

  read -rp "Search: " SEARCH
  ENCODED_SEARCH=${SEARCH// /+}

  tmp=$(mktemp);
  {
    while [ -z "$PAGE" ]; do
      PAGE=$( curl -sSf -x "$PROXY" --retry 20 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 30 "https://xhamster1.desi/search/$ENCODED_SEARCH" 2>/dev/null|
        grep -B2 '<li class="next">' |
        get_grep 'data-page="\K\d+' |
        tail -n 1
      )
      [ -z "$PAGE" ] 
    done

    echo "$PAGE" > "$tmp"
  }&
pid=$!

spinner "$pid" "pages"
wait "$pid"
PAGE=$(cat $tmp)
rm "$tmp";
{ 
  for ((i = 1; i <= PAGE; i++)); do
    curl -sSf -x "$PROXY" --retry 20 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 30 https://xhamster1.desi/search/$ENCODED_SEARCH?page=$i 2>/dev/null \
      | get_grep '<a[^>]+href="https://[^"]+/videos/[^"]+"[^>]*>.*?</a>' \
      | sed -nE 's/.*href="([^"]+)".*aria-label="([^"]+)".*(data-src|src)="([^"]+\.jpg)".*/\1\t\2\t\4/p' 
    done
    notify-send -a "por-cli" "Pages loaded" "All $PAGE pages fetched. Select a video."
  } | 
    awk '!seen[$1]++' |
    fzf --prompt="filter:" --layout=reverse --with-shell="bash -c" --delimiter=$'\t' --with-nth=2 \
    --preview "
  $(typeset -f preview)
  preview {3} " \
    --bind "enter:execute(
      $(typeset -f spinner)
      $(typeset -f player)
      $(typeset -f get_grep)
      $(typeset -x TERMINAL)
      url='{1}';
      name={2};
      tmp=\$(mktemp);
      {
        echo \"\$url\" >> \"${XDG_STATE_HOME:-$HOME/.local/state}/por-cli/watch.history\";
        playlist=\"\"
        while [ -z \"\$playlist\" ]; do
          playlist=\$(curl -sSf -x \"$PROXY\" --retry 20 --retry-delay 2 --retry-all-errors \
            --connect-timeout 10 --max-time 30 \"\$url\" 2>/dev/null \
            | get_grep 'https://[^\" ]+\\.m3u8' \
            | head -n1);
          [ -z \"\$playlist\" ]
        done
        echo \"\$playlist\" > \"\$tmp\";
      } &
    pid=\$!;
    spinner \"\$pid\" \"playlist\";
    wait \"\$pid\";
    playlist=\$(cat \"\$tmp\");
    rm \"\$tmp\";
    [ -n \"\$playlist\" ] && player \"\$playlist\" \"\$name\"
    )"
    pkill $pid
    echo $pid
    exit 0

  elif [[ $selected == "eporner" ]]; then
    read -rp "Search: " SEARCH
    ENCODED_SEARCH=${SEARCH// /+}
    tmp=$(mktemp);
    {
      PAGE=$(curl -Ls -x "$PROXY" --retry 20 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 30 \
        "https://www.eporner.com/api/v2/video/search/?query=$ENCODED_SEARCH&page=1&per_page=30&format=json" \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" \
        2>/dev/null | jq -r '.total_pages // 1')
      [ -z "$PAGE" ] && PAGE=1
      echo "$PAGE" > "$tmp"
    }&
    pid=$!

