    rm "$tmp";
    {
      for ((i = 1; i <= PAGE; i++)); do
        curl -Ls --retry 20 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 30 -x "$PROXY" \
          "https://www.eporner.com/api/v2/video/search/?query=$ENCODED_SEARCH&page=$i&per_page=30&format=json" \
          -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" \
          2>/dev/null | jq -r '.videos[] | [.url, .title, .default_thumb.src] | @tsv'
      done
      notify-send -a "por-cli" "Pages loaded" "All $PAGE pages fetched. Select a video."
    } |
      awk '!seen[$1]++' |
      fzf --prompt="filter:" --layout=reverse --with-shell="bash -c" --delimiter=$'\t' --with-nth=2 \
      --preview "
  $(typeset -f preview)
  preview {3} " \
      --bind "enter:execute(
        $(typeset -f spinner)
        $(typeset -f player)
        $(typeset -f get_grep)
        $(typeset -x TERMINAL)
        url={1};
        name={2};
        tmp=\$(mktemp);
        {
          echo \"\$url\" >> \"\${XDG_STATE_HOME:-$HOME/.local/state}/por-cli/watch.history\";
          echo \"\$url\" > \"\$tmp\";
        }&
      pid=\$!;
      spinner \"\$pid\" \"playlist\";
      wait \"\$pid\";
      playlist=\$(cat \"\$tmp\");
      rm \"\$tmp\";
      [ -n \"\$playlist\" ] && player \"\$playlist\" \"\$name\"
      )"
      pkill $pid
      exit 0

  elif [[ $selected == "xvideos" ]]; then
    read -rp "Search: " SEARCH
    ENCODED_SEARCH=${SEARCH// /+}
    tmp=$(mktemp);
    { 
      while [ -z "$PAGE" ]; do
        PAGE=$(curl -Ls -x "$PROXY" --retry 20 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 30 "https://www.xvideos.com/?k=$ENCODED_SEARCH&p=0" -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" 2>/dev/null |
          tr '\n' ' ' |
          grep -oP 'href="[^"]*&amp;p=\K\d+' |
          sort -n |
          tail -n1
        )

        [ -z "$PAGE" ] && PAGE=0
      done

      echo "$PAGE" > "$tmp"
    }&
  pid=$!

