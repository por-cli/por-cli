  rm "$tmp";
  {
    for ((i = 0; i <= PAGE; i++)); do
      curl -Ls --retry 20 --retry-delay 2 --retry-all-errors --connect-timeout 10 --max-time 30 -x "$PROXY" "https://www.xvideos.com/?k=$ENCODED_SEARCH&p=$i" -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" 2>/dev/null |
        tr '\n' ' ' |
        get_grep '<div[^>]+class="[^"]*thumb-block[^"]*"[^>]*>.*?(?=<div[^>]+class="[^"]*thumb-block[^"]*"[^>]*>|$)' |
        sed -E 's|.*<img[^>]+data-src="([^"]+)".*<a[^>]+href="(/video[^"]+)".*title="([^"]+)".*|\2\t\3\t\1|'
    done
    notify-send -a "por-cli" "Pages loaded" "All $PAGE pages fetched. Select a video."
  } | 
    awk '!seen[$1]++' |
    fzf --prompt="filter:" --layout=reverse --with-shell="bash -c" --delimiter=$'\t' --with-nth=2 \
    --preview "
  $(typeset -f preview)
  preview {3} " \
    --bind "enter:execute(
      $(typeset -f spinner)
      $(typeset -f player)
      $(typeset -f get_grep)
      $(typeset -x TERMINAL)
      url=https://www.xvideos.com{1};
      name={2};
      tmp=\$(mktemp);
      {
        echo \"\$url\" >> \"${XDG_STATE_HOME:-$HOME/.local/state}/por-cli/watch.history\";
        playlist=\"\"
        while [ -z \"\$playlist\" ]; do
          playlist=\$(curl -Lvs -x \"\$PROXY\" \"\$url\" -A \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\" 2>/dev/null |
            tr '\n' ' ' |
            grep -oP \"setVideoHLS\\('\K[^']+\");
          [ -z \"\$playlist\" ]
        done
        echo \"\$playlist\" > \"\$tmp\";
      }&
    pid=\$!;
    spinner \"\$pid\" \"playlist\";
    wait \"\$pid\";
    playlist=\$(cat \"\$tmp\");
    rm \"\$tmp\";
    [ -n \"\$playlist\" ] && player \"\$playlist\" \"\$name\"
    )"
    pkill $pid
    exit 0

  elif [[ $selected == "donate" ]]; then
    sponsor=`echo "buymeacoffee github" | tr ' ' '\n'`
    selected=`printf "$sponsor" | fzf --prompt="filter:" --layout=reverse`
      if [[ $selected == "github" ]]; then
        get_open "https://github.com/sponsors/GhostGamer6969"
